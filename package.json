{
  "name": "pulseos-node",
  "private": true,
  "workspaces": [
    "packages/shared",
    "packages/e2e",
    "apps/agent",
    "apps/dashboard"
  ],
  "scripts": {
    "dev:agent": "npm run dev --workspace=apps/agent",
    "dev:dashboard": "npm run dev --workspace=apps/dashboard",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p apps/agent/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json"
  }
}
