{
  "name": "pulseos-node",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "workspaces": [
    "packages/shared",
    "apps/agent",
    "apps/dashboard"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "pnpm --filter @pulseos/agent dev & pnpm --filter @pulseos/dashboard dev",
    "dev:agent": "pnpm --filter @pulseos/agent dev",
    "dev:dashboard": "pnpm --filter @pulseos/dashboard dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:agent": "pnpm --filter @pulseos/agent exec playwright test",
    "test:e2e:dashboard": "pnpm --filter @pulseos/dashboard exec playwright test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p apps/agent/tsconfig.json && tsc --noEmit -p apps/dashboard/tsconfig.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "lefthook": "^2.1.14",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
